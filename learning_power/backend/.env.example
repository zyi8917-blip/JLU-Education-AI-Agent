# Flask配置
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DEBUG=True

# 数据库配置
DATABASE_URL=sqlite:///./creativity_assessment.db

# AI配置（OpenAI 兼容接口，示例为 DeepSeek）
SILICONFLOW_API_KEY=your-api-key
SILICONFLOW_BASE_URL=https://api.deepseek.com/v1
SILICONFLOW_MODEL_CHAT_A=deepseek-chat
SILICONFLOW_MODEL_CHAT_B=deepseek-chat
OPENAI_API_KEY=your-api-key

# 测评配置
MAX_QUESTIONS=10
TIME_LIMIT_MINUTES=30

# 服务器配置
HOST=0.0.0.0
PORT=5000

# LangChain RAG（默认开启；false 回退原生 chromadb）
USE_LC_RAG=true
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 国内下载 Embedding 模型可设 HF_ENDPOINT=https://hf-mirror.com
HF_ENDPOINT=

USE_LC_EVAL=true
