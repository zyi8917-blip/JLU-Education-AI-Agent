# Copy to .env.local (do not commit .env.local)
OPENAI_API_KEY=
# DeepSeek 示例
OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat

# Optional: set to "true" at build time to force LLM mode in the browser bundle
# NEXT_PUBLIC_USE_LLM=true

# Flask backend (LangGraph 测评 + 画像对话 + RAG 课堂)
FLASK_API_BASE_URL=http://127.0.0.1:5000
# NEXT_PUBLIC_FLASK_API_BASE_URL=http://127.0.0.1:5000
